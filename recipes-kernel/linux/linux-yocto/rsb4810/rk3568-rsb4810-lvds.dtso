/*
 * Advantech RSB-4810: single-channel LVDS0 panel on the 40-pin LVDS
 * connector (schematic A104-1, sheet 26).
 *
 * Needs the out-of-tree "drm/rockchip: add RK3568 LVDS support" series
 * (provides the &lvds node with the lvds_in/lvds_out ports).
 *
 * LVDS0 is fed from VOP2 video port 1: vp0 already drives HDMI and vp2 has
 * a known bug with this driver. DCLK_VOP1 is parented to VPLL in the base
 * devicetree.
 *
 * Panel supply (jumper VDD2: 3.3 V/5 V) and backlight supply (jumper BLP1:
 * 5 V/12 V) are selected by hand on the board; set them to match the panel.
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/soc/rockchip,vop2.h>

&{/} {
	/* LCD_EN (GPIO3_C6) drives the load switch producing VDD_LVDS */
	vdd_lvds: regulator-vdd-lvds {
		compatible = "regulator-fixed";
		regulator-name = "vdd_lvds";
		gpio = <&gpio3 RK_PC6 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <20000>;
		pinctrl-names = "default";
		pinctrl-0 = <&lcd_en_h>;
	};

	backlight_lvds: backlight-lvds {
		compatible = "pwm-backlight";
		pwms = <&pwm4 0 25000 0>;
		/* LVDS_BLENH: GPIO0_A0 (ball AG27) - verify on hardware */
		enable-gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
		brightness-levels = <0 255>;
		num-interpolated-steps = <255>;
		default-brightness-level = <200>;
		pinctrl-names = "default";
		pinctrl-0 = <&lvds_blen_h>;
	};

	panel {
		/*
		 * TODO: replace with the panel's own compatible. The kit in use
		 * is labelled Advantech IDK-1107WR-40WVA1E (AUO G070VW01 V0).
		 */
		compatible = "advantech,idk-1107wr", "panel-lvds";
		power-supply = <&vdd_lvds>;
		reset-gpios = <&gpio3 RK_PC7 GPIO_ACTIVE_LOW>;
		backlight = <&backlight_lvds>;
		pinctrl-names = "default";
		pinctrl-0 = <&lcd_rst_l>;

		/*
		 * TODO: replace with panel datasheet values (nominal 7" 15:9
		 * active area, matching the G070VW01 label)
		 */
		width-mm = <152>;
		height-mm = <91>;
		/* TODO: replace with panel datasheet values */
		data-mapping = "vesa-24";

		/* TODO: replace with panel datasheet values */
		panel-timing {
			clock-frequency = <71100000>;
			hactive = <1280>;
			vactive = <800>;
			hfront-porch = <48>;
			hback-porch = <80>;
			hsync-len = <32>;
			vfront-porch = <3>;
			vback-porch = <14>;
			vsync-len = <6>;
		};

		port {
			panel_in_lvds: endpoint {
				remote-endpoint = <&lvds_out_panel>;
			};
		};
	};
};

&dsi_dphy0 {
	status = "okay";
};

&lvds {
	status = "okay";
};

&lvds_in {
	lvds_in_vp1: endpoint {
		remote-endpoint = <&vp1_out_lvds0>;
	};
};

&lvds_out {
	lvds_out_panel: endpoint {
		remote-endpoint = <&panel_in_lvds>;
	};
};

&pinctrl {
	lvds-panel {
		lcd_en_h: lcd-en-h {
			rockchip,pins = <3 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		lcd_rst_l: lcd-rst-l {
			rockchip,pins = <3 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		lvds_blen_h: lvds-blen-h {
			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&vp1 {
	#address-cells = <1>;
	#size-cells = <0>;

	vp1_out_lvds0: endpoint@ROCKCHIP_VOP2_EP_LVDS0 {
		reg = <ROCKCHIP_VOP2_EP_LVDS0>;
		remote-endpoint = <&lvds_in_vp1>;
	};
};
