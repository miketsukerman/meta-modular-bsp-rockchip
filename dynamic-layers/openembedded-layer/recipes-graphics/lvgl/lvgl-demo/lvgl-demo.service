[Unit]
Description=LVGL widgets demo (Wayland client under Weston, else DRM/KMS)
ConditionPathExists=/dev/dri
# With Weston (core-image-weston) the demo connects to /run/wayland-0;
# without a compositor it drives the display directly.
After=weston.service

[Service]
Type=simple
# Select the backend, output and input with "systemctl edit lvgl-demo":
#   [Service]
#   Environment=LV_BACKEND=drm
#   Environment=LV_DRM_CONNECTOR=<id from "modetest -M rockchip -c">
#   Environment=LV_EVDEV_DEVICE=/dev/input/by-id/<touchscreen>-event
ExecStart=/usr/bin/lvgl-demo
Restart=on-failure

[Install]
WantedBy=multi-user.target
